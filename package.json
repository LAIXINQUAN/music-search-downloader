{
  "name": "music-downloader",
  "version": "3.7.0",
  "description": "音乐搜索与下载平台 - 基于 Electron + Express 的 Windows 桌面客户端",
  "author": "LAIXINGQUAN (https://github.com/LAIXINGQUAN)",
  "main": "main.js",
  "scripts": {
    "start": "node index.js",
    "electron": "electron .",
    "build": "node scripts/set-edition.js oss && electron-builder --win",
    "build:pro": "node scripts/set-edition.js pro && electron-builder --win",
    "electron:oss": "node scripts/set-edition.js oss && electron .",
    "electron:pro": "node scripts/set-edition.js pro && electron ."
  },
  "build": {
    "appId": "com.laixingquan.musicdownloader",
    "productName": "QB音乐",
    "publish": null,
    "directories": {
      "output": "dist30"
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/fluent-ffmpeg/**"
    ],
    "files": [
      "main.js",
      "preload.js",
      "preload-desktop-lyrics.js",
      "preload-mini-player.js",
      "index.js",
      "Music_31107.ico",
      "edition.json",
      "desktop-lyrics.html",
      "mini-player.html",
      "public/**/*",
      "routes/**/*",
      "controllers/**/*",
      "services/**/*",
      "utils/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "动态壁纸",
        "to": "动态壁纸"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "Music_31107.ico",
      "artifactName": "QB音乐-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "uninstallDisplayName": "QB音乐",
      "shortcutName": "QB音乐",
      "license": "授权书.txt",
      "include": "installer.nsh",
      "installerIcon": "Music_31107.ico",
      "installerHeaderIcon": "Music_31107.ico",
      "installerSidebar": "installer-sidebar.jpg",
      "uninstallerSidebar": "installer-sidebar.jpg",
      "deleteAppDataOnUninstall": false,
      "displayLanguageSelector": false,
      "warningsAsErrors": false,
      "differentialPackage": false
    }
  },
  "keywords": [],
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "axios": "^1.18.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^8.3.0",
    "multer": "^2.2.0",
    "music-metadata": "^11.15.0",
    "nodemailer": "^9.0.6"
  },
  "devDependencies": {
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3"
  }
}
